{
  "name": "dashgrid",
  "version": "1.0.0",
  "description": "A Docker-ready monitoring wallboard with a visual editor, REST API, and threshold-based tile colors.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.app.json && vite build",
    "start": "node dist/server/index.js",
    "demo:restore": "node dist/server/demo-cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@fontsource/open-sans": "^5.2.5",
    "fastify": "^5.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
